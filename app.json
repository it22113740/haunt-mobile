{
  "expo": {
    "name": "Hunt",
    "slug": "hunt-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "huntmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hunt uses your location to find nearby restaurants and bars.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Hunt uses your location in the background to notice when you arrive at a place and tell you about points you can earn.",
        "NSLocationAlwaysUsageDescription": "Hunt uses your location in the background to notice when you arrive at a place and tell you about points you can earn.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.hunt.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#F5F1E8",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hunt uses your location to find nearby restaurants and bars.",
          "locationAlwaysAndWhenInUsePermission": "Hunt uses your location in the background to notice when you arrive at a place and tell you about points you can earn.",
          "locationAlwaysPermission": "Hunt uses your location in the background to notice when you arrive at a place and tell you about points you can earn.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FC6401",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hunt uses your photos so you can submit a visit.",
          "cameraPermission": "Hunt uses your camera to capture a visit."
        }
      ],
      "expo-video",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAKA99jWK6_cPOSyKlhRtwpak8MxwrmO5M"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ef7d80d-f5eb-4a91-ad13-32d4330fa151"
      }
    },
    "owner": "santa07"
  }
}
